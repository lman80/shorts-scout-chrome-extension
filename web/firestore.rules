rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // OPEN MODE: every board document (the shared "Ashton"/"Team" boards, each
    // user's personal board, and the "registry" doc that lists the users) is
    // readable/writable by anyone with the site URL — no sign-in. This is what
    // lets the multi-user switcher and cross-device sync work. Keep the URL
    // private. Only documents under /boards are exposed; nothing else is.
    match /boards/{boardId} {
      allow read, write: if true;
    }
  }
}
